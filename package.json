{
  "name": "desk-plan-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run",
    "test:legacy": "node --test features/simulator/browser-tools/create-layout-tools.test.mjs",
    "test:e2e": "playwright test",
    "test:inventory": "vitest run tests/test-inventory.test.ts",
    "test:install": "playwright install chromium",
    "test:update-snapshots": "playwright test tests/e2e/visual-layout.spec.ts --update-snapshots",
    "docs:spec": "node scripts/render-spec.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^29.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^5.0.3"
  }
}
